<?php

class Aluno {
    private string $nome;
    private array $notas = [];

    public function __construct(string $nome) {
        $this->nome = $nome;
    }

    public function adicionarNota(float $nota): void {
        $this->notas[] = $nota;
    }

    public function calcularMedia(): float {
        if (empty($this->notas)) {
            return 0.0;
        }
        return array_sum($this->notas) / count($this->notas);
    }

    public function isAprovado(): bool {
        return $this->calcularMedia() >= 7;
    }

    public function getNome(): string {
        return $this->nome;
    }
}

$aluno = new Aluno("Carlos");

$aluno->adicionarNota(8.5);
$aluno->adicionarNota(7.5);

echo "Aluno: " . $aluno->getNome() . "\n";
echo "Média final: " . number_format($aluno->calcularMedia(), 2) . "\n";
echo "Status: " . ($aluno->isAprovado() ? "Aprovado" : "Reprovado") . "\n";

